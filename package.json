{
  "name": "learning-log",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.dev.jsonc --ip 127.0.0.1 --port 8787",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply learning-log-files --local --config wrangler.dev.jsonc",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:search": "node --test tests/search-navigation.test.mjs",
    "test:api": "node --test tests/api.test.mjs tests/reorder.test.mjs",
    "test": "npm run test:search && npm run test:api"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.2-beta",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wrangler": "^4.152.0"
  }
}
