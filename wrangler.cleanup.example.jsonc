{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learning-log-files-cleanup",
  "main": "./server/cleanup-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [{
    "binding": "MY_DB",
    "database_name": "logsite-files",
    "database_id": "REPLACE_WITH_LEARNING_LOG_DATABASE_ID"
  }],
  "r2_buckets": [{ "binding": "MY_BUCKET", "bucket_name": "logsites-files" }]
}
