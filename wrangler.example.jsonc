{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learning-log",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "learning-log-files",
    "database_id": "REPLACE_WITH_LEARNING_LOG_DATABASE_ID",
    "migrations_dir": "./migrations"
  }],
  "r2_buckets": [{ "binding": "MY_BUCKET", "bucket_name": "logsites-files" }]
}
